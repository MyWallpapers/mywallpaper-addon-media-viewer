{
  "runtime": "canvas-v1",
  "name": "Media Viewer",
  "description": "Displays images, animated images, videos, audio and supported browser embeds from one live media resource.",
  "version": "4.0.0",
  "entry": "dist/index.html",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "auto"
  },
  "settings": [
    {
      "id": "source",
      "type": "section",
      "label": "Source"
    },
    {
      "id": "media",
      "type": "resource",
      "label": "Media",
      "description": "Choose a local file or enter a live URL. Browser CORS and embed policies are respected.",
      "parent": "source",
      "scope": "layer",
      "mirrorEligible": true
    },
    {
      "id": "mediaType",
      "type": "select",
      "label": "Media type",
      "description": "Auto uses the URL extension. Select an explicit type for extensionless local or live resources.",
      "parent": "source",
      "scope": "layer",
      "default": "auto",
      "options": [
        { "label": "Automatic", "value": "auto" },
        { "label": "Image or GIF", "value": "image" },
        { "label": "Video", "value": "video" },
        { "label": "Audio", "value": "audio" },
        { "label": "Web embed", "value": "embed" }
      ]
    },
    {
      "id": "playback",
      "type": "section",
      "label": "Playback"
    },
    {
      "id": "autoplay",
      "type": "boolean",
      "label": "Autoplay",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "loop",
      "type": "boolean",
      "label": "Loop",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "muted",
      "type": "boolean",
      "label": "Muted",
      "description": "Most browsers require muted media for autoplay.",
      "parent": "playback",
      "scope": "layer",
      "default": true
    },
    {
      "id": "volume",
      "type": "range",
      "label": "Volume",
      "parent": "playback",
      "scope": "layer",
      "default": 80,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "playbackRate",
      "type": "range",
      "label": "Playback speed",
      "parent": "playback",
      "scope": "layer",
      "default": 1,
      "min": 0.25,
      "max": 2,
      "step": 0.25
    },
    {
      "id": "startAtSeconds",
      "type": "number",
      "label": "Start at (seconds)",
      "parent": "playback",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 86400,
      "step": 1
    },
    {
      "id": "showControls",
      "type": "boolean",
      "label": "Show controls",
      "parent": "playback",
      "scope": "layer",
      "default": false
    },
    {
      "id": "clickToToggle",
      "type": "boolean",
      "label": "Click to play or pause",
      "parent": "playback",
      "scope": "layer",
      "default": false
    },
    {
      "id": "display",
      "type": "section",
      "label": "Display"
    },
    {
      "id": "objectFit",
      "type": "select",
      "label": "Fit",
      "parent": "display",
      "scope": "layer",
      "default": "contain",
      "options": [
        { "label": "Contain", "value": "contain" },
        { "label": "Cover", "value": "cover" },
        { "label": "Stretch", "value": "fill" },
        { "label": "Original size", "value": "none" },
        { "label": "Scale down only", "value": "scale-down" }
      ]
    },
    {
      "id": "objectPosition",
      "type": "select",
      "label": "Position",
      "parent": "display",
      "scope": "layer",
      "default": "center",
      "options": [
        { "label": "Center", "value": "center" },
        { "label": "Top", "value": "top" },
        { "label": "Bottom", "value": "bottom" },
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" },
        { "label": "Top left", "value": "top left" },
        { "label": "Top right", "value": "top right" },
        { "label": "Bottom left", "value": "bottom left" },
        { "label": "Bottom right", "value": "bottom right" }
      ]
    },
    {
      "id": "backgroundColor",
      "type": "color",
      "label": "Background",
      "parent": "display",
      "scope": "layer",
      "alpha": true,
      "default": "#00000000"
    },
    {
      "id": "borderRadius",
      "type": "range",
      "label": "Corner radius",
      "parent": "display",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "effects",
      "type": "section",
      "label": "Effects",
      "parent": "display",
      "defaultCollapsed": true
    },
    {
      "id": "opacity",
      "type": "range",
      "label": "Opacity",
      "parent": "effects",
      "scope": "layer",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "blur",
      "type": "range",
      "label": "Blur",
      "parent": "effects",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "id": "brightness",
      "type": "range",
      "label": "Brightness",
      "parent": "effects",
      "scope": "layer",
      "default": 100,
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "id": "contrast",
      "type": "range",
      "label": "Contrast",
      "parent": "effects",
      "scope": "layer",
      "default": 100,
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "id": "saturation",
      "type": "range",
      "label": "Saturation",
      "parent": "effects",
      "scope": "layer",
      "default": 100,
      "min": 0,
      "max": 200,
      "step": 1
    },
    {
      "id": "hueRotate",
      "type": "range",
      "label": "Hue rotation",
      "parent": "effects",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 360,
      "step": 1
    },
    {
      "id": "advanced",
      "type": "section",
      "label": "Advanced",
      "defaultCollapsed": true
    },
    {
      "id": "refreshInterval",
      "type": "number",
      "label": "Reload interval (minutes)",
      "description": "Zero disables reload. Useful for changing images and camera endpoints.",
      "parent": "advanced",
      "scope": "layer",
      "default": 0,
      "min": 0,
      "max": 1440,
      "step": 1
    },
    {
      "id": "fallbackText",
      "type": "string",
      "label": "Failure message",
      "parent": "advanced",
      "scope": "layer",
      "default": "Media unavailable"
    }
  ]
}
